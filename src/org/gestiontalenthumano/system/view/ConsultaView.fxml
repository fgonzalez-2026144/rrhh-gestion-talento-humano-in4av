<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="dashboard-root" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.gestiontalentoshumanos.system.controller.ConsultaController">

    <!-- Barra lateral -->
    <left>
        <VBox prefWidth="230" spacing="4" styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="sidebar-brand">
                <Label styleClass="sidebar-brand-icon" text="👥" />
                <VBox spacing="0">
                    <Label styleClass="sidebar-brand-title" text="RRHH" />
                    <Label styleClass="sidebar-brand-subtitle" text="Gestion de Talento Humano" wrapText="true" />
                </VBox>
            </HBox>

            <VBox spacing="2" styleClass="sidebar-menu">
                <Button maxWidth="Infinity" onAction="#onInicio" styleClass="sidebar-item" text="🏠   Inicio" />
                <Button maxWidth="Infinity" styleClass="sidebar-item, sidebar-item-active" text="🔍   Colaboradores" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Region styleClass="sidebar-divider">
                <VBox.margin><Insets bottom="12" left="4" right="4" top="4" /></VBox.margin>
            </Region>

            <Button maxWidth="Infinity" onAction="#onCerrarSesion" styleClass="sidebar-item, sidebar-logout" text="🚪   Cerrar sesion" />
        </VBox>
    </left>

    <!-- Contenido principal -->
    <center>
        <VBox spacing="24" styleClass="dashboard-content">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label styleClass="page-title" text="Colaboradores" />
                    <Label styleClass="page-subtitle" text="Consulta, edita o elimina la informacion del personal registrado." />
                </VBox>
                <Label styleClass="icon-badge, badge-blue" text="👤" />
                <VBox alignment="CENTER_LEFT" spacing="0">
                    <Label fx:id="lblUsuarioActivo" styleClass="user-name" text="Ana Perez" />
                    <Label fx:id="lblRolActivo" styleClass="user-role" text="Recursos Humanos" />
                </VBox>
            </HBox>

            <VBox spacing="16" styleClass="section-card" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <TextField fx:id="txtBuscar" promptText="Buscar por ID, nombre, puesto o departamento" styleClass="search-field" HBox.hgrow="ALWAYS" />
                    <Button onAction="#onNuevoColaborador" styleClass="btn-primary" text="➕  Nuevo colaborador" />
                </HBox>

                <TableView fx:id="tablaEmpleados" styleClass="tabla-empleados" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="70" text="ID" />
                        <TableColumn fx:id="colNombre" prefWidth="220" text="Nombre completo" />
                        <TableColumn fx:id="colPuesto" prefWidth="150" text="Puesto" />
                        <TableColumn fx:id="colDepartamento" prefWidth="150" text="Departamento" />
                        <TableColumn fx:id="colFecha" prefWidth="130" text="Fecha de contratacion" />
                        <TableColumn fx:id="colSalario" prefWidth="120" text="Salario base" />
                        <TableColumn fx:id="colAcciones" prefWidth="190" text="Acciones" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
