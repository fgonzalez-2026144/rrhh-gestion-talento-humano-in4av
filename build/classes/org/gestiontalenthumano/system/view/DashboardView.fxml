<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="dashboard-root" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.gestiontalentoshumanos.system.controller.DashboardController">

    <!-- Barra lateral -->
    <left>
        <VBox prefWidth="230" spacing="4" styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="sidebar-brand">
                <Label styleClass="sidebar-brand-icon" text="👥" />
                <VBox spacing="0">
                    <Label styleClass="sidebar-brand-title" text="RRHH" />
                    <Label styleClass="sidebar-brand-subtitle" text="Gestion de Talento Humano" wrapText="true" />
                </VBox>
            </HBox>

            <VBox spacing="2" styleClass="sidebar-menu">
                <Button maxWidth="Infinity" styleClass="sidebar-item, sidebar-item-active" text="🏠   Inicio" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Region styleClass="sidebar-divider">
                <VBox.margin><Insets bottom="12" left="4" right="4" top="4" /></VBox.margin>
            </Region>

            <Button maxWidth="Infinity" onAction="#onCerrarSesion" styleClass="sidebar-item, sidebar-logout" text="🚪   Cerrar sesion" />
        </VBox>
    </left>

    <!-- Contenido principal -->
    <center>
        <VBox spacing="24" styleClass="dashboard-content">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label styleClass="page-title" text="Recursos Humanos" />
                    <Label styleClass="page-subtitle" text="Gestiona la informacion del personal y los procesos de talento humano." />
                </VBox>
                <Label styleClass="icon-badge, badge-blue" text="👤" />
                <VBox alignment="CENTER_LEFT" spacing="0">
                    <Label fx:id="lblUsuarioActivo" styleClass="user-name" text="Ana Perez" />
                    <Label fx:id="lblRolActivo" styleClass="user-role" text="Recursos Humanos" />
                </VBox>
            </HBox>

            <HBox spacing="20" styleClass="stats-row">
                <VBox spacing="10" styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="icon-badge, badge-blue" text="👥" />
                    <Label styleClass="stat-label" text="Total colaboradores" />
                    <Label fx:id="lblTotalColaboradores" styleClass="stat-value" text="124" />
                </VBox>
                <VBox spacing="10" styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="icon-badge, badge-violet" text="📄" />
                    <Label styleClass="stat-label" text="Nuevos este mes" />
                    <Label fx:id="lblNuevosEsteMes" styleClass="stat-value" text="8" />
                </VBox>
                <VBox spacing="10" styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="icon-badge, badge-amber" text="📅" />
                    <Label styleClass="stat-label" text="En proceso" />
                    <Label fx:id="lblEnProceso" styleClass="stat-value" text="3" />
                </VBox>
                <VBox spacing="10" styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="icon-badge, badge-green" text="✅" />
                    <Label styleClass="stat-label" text="Contratados" />
                    <Label fx:id="lblContratados" styleClass="stat-value" text="113" />
                </VBox>
            </HBox>

            <VBox spacing="14" styleClass="section-card">
                <Label styleClass="section-title" text="Acciones rapidas" />
                <HBox spacing="16">
                    <Button maxWidth="Infinity" onAction="#onRegistrarColaborador" styleClass="action-tile, tile-blue" text="Registrar&#10;colaborador" HBox.hgrow="ALWAYS">
                        <graphic><Label styleClass="icon-badge, badge-blue" text="➕" /></graphic>
                    </Button>
                    <Button maxWidth="Infinity" onAction="#onConsultarColaboradores" styleClass="action-tile, tile-cyan" text="Consultar&#10;colaboradores" HBox.hgrow="ALWAYS">
                        <graphic><Label styleClass="icon-badge, badge-cyan" text="🔍" /></graphic>
                    </Button>
                    <Button maxWidth="Infinity" styleClass="action-tile, tile-violet" text="Generar&#10;reportes" HBox.hgrow="ALWAYS">
                        <graphic><Label styleClass="icon-badge, badge-violet" text="📋" /></graphic>
                    </Button>
                    <Button maxWidth="Infinity" styleClass="action-tile, tile-green" text="Gestionar&#10;nomina" HBox.hgrow="ALWAYS">
                        <graphic><Label styleClass="icon-badge, badge-green" text="💰" /></graphic>
                    </Button>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
